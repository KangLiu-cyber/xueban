{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "学伴",
  "version": "0.1.0",
  "identifier": "com.xueban.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "beforeDevCommand": "trunk serve ../web",
    "beforeBuildCommand": "trunk build ../web"
  },
  "app": {
    "windows": [
      {
        "title": "学伴 · 超级学习助手",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
