{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "学伴",
  "version": "0.1.0",
  "identifier": "com.xueban.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "beforeDevCommand": "cd web && trunk serve",
    "beforeBuildCommand": "cd web && trunk build --release"
  },
  "app": {
    "windows": [
      {
        "title": "学伴 · 超级学习助手",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
