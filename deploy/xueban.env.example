# 学伴后端环境变量模板（systemd 部署，docs/architecture.md §11）。
# 安装时由 scripts/install-systemd.sh 复制为 /etc/xueban/xueban.env 并 chmod 600；
# 修改后执行 `systemctl restart xueban` 生效。生产环境务必改掉所有占位值。

# PostgreSQL 连接串（必填）：<用户>:<密码>@<地址>:<端口>/<库名>
DATABASE_URL=postgres://xueban:CHANGE_ME@127.0.0.1:5432/xueban

# 监听地址：systemd 部署下 server 只对内，nginx 反代到 8080，故绑 127.0.0.1 即可
BIND_ADDR=127.0.0.1:8080

# MCP 网关对外地址（随 Agent 凭证下发，须为客户端可访问的域名/公网地址）
MCP_ENDPOINT=https://buildstore.mjcode.top/mcp

# 内置 Skill 目录（install-systemd.sh 把 skills/ 复制到这里）
SKILLS_DIR=/etc/xueban/skills

# 附件二进制根目录（install-systemd.sh 预创建，属主 xueban:xueban）
ATTACHMENTS_DIR=/var/lib/xueban/attachments
